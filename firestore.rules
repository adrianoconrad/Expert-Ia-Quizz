rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Shared Helpers
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerified() && 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
         request.auth.token.email == "adrianoconrad@gmail.com");
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Entity Validation Blueprints
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'role']) && 
             data.keys().size() <= 20 &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.role in ['user', 'admin'] &&
             data.createdAt is timestamp;
    }

    function isValidStudyLog(data) {
      return data.keys().hasAll(['uid', 'date', 'subject', 'fileNames']) && 
             data.keys().size() == 4 &&
             data.uid == request.auth.uid &&
             data.date is timestamp &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() < 200 &&
             data.fileNames is string && data.fileNames.size() < 5000;
    }

    function isValidResult(data) {
      return data.keys().hasAll(['uid', 'date', 'correct', 'total', 'timeSpent', 'fileName', 'questions', 'answers']) &&
             data.uid == request.auth.uid &&
             data.date is timestamp &&
             data.correct is int && 
             data.total is int &&
             data.timeSpent is int &&
             data.fileName is string && data.fileName.size() < 500 &&
             data.questions is list && data.questions.size() <= 100 &&
             data.answers is list && data.answers.size() <= 100;
    }

    function isValidRevisionTask(data) {
      return data.keys().hasAll(['id', 'uid', 'quizId', 'subject', 'fileName', 'dueDate', 'completed', 'intervalDays']) &&
             data.keys().size() == 8 &&
             data.uid == request.auth.uid &&
             data.dueDate is timestamp &&
             data.completed is bool &&
             data.intervalDays is int;
    }

    function isValidFlashcard(data) {
      return data.keys().hasAll(['uid', 'front', 'back', 'subject', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.front is string && data.front.size() > 0 &&
             data.back is string && data.back.size() > 0;
    }

    function isValidSRSItem(data) {
      return data.keys().hasAll(['uid', 'questionId', 'question', 'correctAnswer', 'interval', 'easeFactor', 'nextReviewDate']) &&
             data.uid == request.auth.uid &&
             data.nextReviewDate is timestamp;
    }

    // ===============================================================
    // Collection Matches
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isVerified() && isValidUser(incoming()) && (incoming().role == 'user' || isAdmin());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        (incoming().role == existing().role || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasAll([]) // Size check in isValidUser
      );
    }

    match /studyLogs/{logId} {
      allow get: if isValidId(logId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(logId) && isVerified() && isValidStudyLog(incoming());
      allow update: if isValidId(logId) && existing().uid == request.auth.uid && isValidStudyLog(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['subject', 'fileNames', 'date'])
      );
      allow delete: if isValidId(logId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /revisionTasks/{taskId} {
      allow get: if isValidId(taskId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(taskId) && isVerified() && isValidRevisionTask(incoming());
      allow update: if isValidId(taskId) && existing().uid == request.auth.uid && isValidRevisionTask(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['dueDate', 'completed', 'intervalDays'])
      );
      allow delete: if isValidId(taskId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /results/{resultId} {
      allow get: if isValidId(resultId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(resultId) && isVerified() && isValidResult(incoming());
      allow update: if isValidId(resultId) && existing().uid == request.auth.uid && isValidResult(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['deleted', 'deletedAt', 'subject', 'revisionTasks'])
      );
      allow delete: if isValidId(resultId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /flashcards/{cardId} {
      allow get: if isValidId(cardId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(cardId) && isVerified() && isValidFlashcard(incoming());
      allow update: if isValidId(cardId) && existing().uid == request.auth.uid && isValidFlashcard(incoming());
      allow delete: if isValidId(cardId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /srs/{itemId} {
      allow get: if isValidId(itemId) && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isValidId(itemId) && isVerified() && isValidSRSItem(incoming());
      allow delete: if isValidId(itemId) && (existing().uid == request.auth.uid || isAdmin());
    }

    match /srs_registries/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && isVerified();
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
